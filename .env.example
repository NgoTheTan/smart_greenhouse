# Sao chép thành .env (KHÔNG commit) rồi điền giá trị thật.
# Docker Compose (deploy/*.yml) đọc file này qua env_file: ../.env

# --- PostgreSQL / TimescaleDB ---
POSTGRES_USER=greenhub
POSTGRES_DB=greenhub
POSTGRES_PASSWORD=change-me
# Trong Docker dùng host "timescaledb"; chạy Python trên laptop thì đổi thành localhost
DATABASE_URL=postgresql+asyncpg://greenhub:change-me@timescaledb:5432/greenhub

# --- Auth ---
JWT_SECRET=change-me-long-random-string
JWT_EXPIRE_MIN=720

# --- MQTT (Mosquitto) ---
# Worker/api nói chuyện với broker qua listener nội bộ (mạng Docker)
MQTT_HOST=mosquitto
MQTT_PORT=1883
# Host/port công khai trả cho gateway khi provisioning (TLS)
MQTT_PUBLIC_HOST=localhost
MQTT_PUBLIC_PORT=8883
MQTT_WORKER_USER=worker
MQTT_WORKER_PASSWORD=change-me
MQTT_ADMIN_USER=api-admin
MQTT_ADMIN_PASSWORD=change-me
# Đường dẫn chứng chỉ TLS bên trong container mosquitto
#   dev : /certs/server.crt, /certs/server.key (tạo bằng deploy/scripts/gen-dev-certs.sh)
#   prod: file Caddy cấp, ví dụ /caddy-data/caddy/certificates/acme-v02.api.letsencrypt.org-directory/<DOMAIN>/<DOMAIN>.crt
MQTT_TLS_CERTFILE=/certs/server.crt
MQTT_TLS_KEYFILE=/certs/server.key

# --- Web Push (VAPID) --- tạo bằng: python -m tools.gen_vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# --- Email (leo thang cảnh báo) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=greenhub@example.com

# --- Triển khai ---
# dev: localhost (Caddy dùng chứng chỉ nội bộ) ; prod: tên miền DuckDNS
DOMAIN=localhost
MODELS_DIR=/models
LOG_LEVEL=INFO

