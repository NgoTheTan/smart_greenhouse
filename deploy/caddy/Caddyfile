# GreenHub - Caddy: HTTPS, phục vụ web build tĩnh, reverse proxy /api và /ws tới api.
# DOMAIN lấy từ .env: "localhost" (dev, chứng chỉ nội bộ của Caddy) hoặc tên miền DuckDNS (prod, Let's Encrypt).
{$DOMAIN:localhost} {
	encode zstd gzip

	handle /api/* {
		reverse_proxy api:8000
	}

	handle /ws* {
		reverse_proxy api:8000
	}

	handle {
		root * /srv
		@sw path /sw.js /manifest.json
		header @sw Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}
}

